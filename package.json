{
  "name": "pos-saas",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "postinstall": "npx prisma generate",
    "db:seed": "prisma db seed"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "turbo": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@neon/config": "^1.8.2",
    "@neon/env": "^1.4.7",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0"
  },
  "prisma": {
    "seed": "ts-node -O '{\"module\":\"CommonJS\"}' prisma/seed.ts"
  }
}
